#!/bin/bash
service=$1
ip=$(curl -s https://api.ipify.org)
os="$(neofetch os)"; os="${os##*: }"
distro="$(neofetch distro)"; distro="${distro##*: }"
cpu="$(neofetch cpu --cpu_speed on --cpu_cores off)"; cpu="${cpu##*: }"
memory="$(neofetch memory)"; memory="${memory##*: }"
disk="$(neofetch disk)"; disk="${disk##*: }"
uptime="$(neofetch uptime)"; uptime="${uptime##*: }"
bandwidth=$(vnstat --oneline | cut -d ";" -f 15)

if [[ $service == "aio" ]]; then
    # 1. LOAD CONFIGS
    [ -f /root/.db-base ] && . /root/.db-base
    [ -f /root/.ports ] && . /root/.ports
    [ -f /etc/openvpn/login/config.sh ] && . /etc/openvpn/login/config.sh

    # 2. SERVICE CHECKING
    tcpovpn=$(systemctl is-active openvpn@server2.service)
    udpovpn=$(systemctl is-active openvpn@server.service)
    udphysteria=$(systemctl is-active hysteria-server.service)
    xray=$(systemctl is-active xray.service)
    slowdns=$(systemctl is-active server-sldns.service)
    sshd=$(systemctl is-active sshd)
    dropbear=$(systemctl is-active dropbear)
    squid=$(systemctl is-active squid)
    ssl=$(systemctl is-active stunnel4)
    socket=$((echo >/dev/tcp/localhost/80) &>/dev/null && echo "active" || echo "inactive")

    # 3. ONLINE USERS
    tcpusers=$(sed -n -e '/^ROUTING_TABLE/p' /etc/openvpn/server/tcpclient.log 2>/dev/null | wc -l)
    udpusers=$(sed -n -e '/^ROUTING_TABLE/p' /etc/openvpn/server/udpclient.log 2>/dev/null | wc -l)
    totalovpn=$((tcpusers + udpusers))
    total_sshd=$(netstat -natp | awk "/$ip:22/ && /ESTABLISHED/ && /sshd/" | wc -l)
    total_dropbear=$(netstat -natp | awk "/$ip:441/ && /ESTABLISHED/ && /dropbear/" | wc -l)
    total_socket1=$(netstat -natp | awk "/$ip:8000/ && /ESTABLISHED/ && /python/" | wc -l)
    totalssh=$((total_sshd + total_dropbear + total_socket1))
    total_hysteria=$(netstat -natp | awk "/$ip:53/ && /ESTABLISHED/ && /hysteria/" | wc -l)

    # 4. JSON OUTPUT (For panel monitoring)
    output=$(cat <<EOF
{
 "service": "aio protocol",
 "ip": "$ip",
 "users": "$totalovpn",
 "bandwidth": "$bandwidth",
 "os": "$os",
 "distro": "$distro",
 "cpu": "$cpu",
 "memory": "$memory",
 "disk": "$disk",
 "uptime": "$uptime"
}
EOF
)
    echo "$output"

    # 5. SQL UPDATE (Saktong-sakto sa table mo)
    mysql -h ${DB_HOST:-$HOST} -u ${DB_USER:-$USER} -p${DB_PASS:-$PASS} -D ${DB_NAME:-$DB} -e "UPDATE server_list SET cpu_model='$cpu', distro='$distro', memory='$memory', uptime='$uptime', disk='$disk', bandwidth='$bandwidth', os='$os', proto='$service', tcp_status='$tcpovpn', udp_status='$udpovpn', hysteria_status='$udphysteria', slowdns_status='$slowdns', ssh_status='$sshd', dropbear_status='$dropbear', squid_status='$squid', ssl_status='$ssl', socket_status='$socket', tcp='$tcp_port', udp='$udp_port', hysteria_port='$hysteria_port', slowdns_port='$slowdns_port', ssh_port='$ssh_port', dropbear_port='$dropbear_port', squid='$squid_port', socket='$socket_port', online='$totalovpn', ssh_online='$totalssh', hysteria_online='$total_hysteria' WHERE server_ip='$ip'"

fi